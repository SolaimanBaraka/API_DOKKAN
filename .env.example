#  Entorno 
# Copia este fichero como .env y rellena los valores reales.
# NUNCA subas .env a git.

# "development" usa SQLite local  "production" usa PostgreSQL
APP_ENV=development

#  Base de datos 
# Solo se usa en APP_ENV=production
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=dokkan
POSTGRES_USER=dokkan
POSTGRES_PASSWORD=changeme_in_production

#  API 
API_HOST=0.0.0.0
API_PORT=8000

#  Scheduler (sync automtico) 
# Hora UTC a la que se ejecuta el sync diario (formato HH:MM)
SYNC_TIME_UTC=03:00
# Rarezas a sincronizar automticamente (separadas por coma)
SYNC_RARITIES=LR,UR
# Mximo de cartas por rareza en cada sync automtico
SYNC_MAX_CARDS=300
# Activar/desactivar sync automtico
SYNC_ENABLED=true
